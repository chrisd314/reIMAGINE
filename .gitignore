# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Local toolchains and caches (re-creatable)
.tools/
.cache/

# Intermediate data, re-created by the pipeline: cleaned records, embedding and part-of-speech caches,
# arrays of every stage, input stamps of the data preparation
data/interim/
data/processed/*.parquet

# Raw source pages of the parables (third-party page markup; data/raw/parables/fetch_log.csv stays tracked)
data/raw/parables/*/

# Development runs (--sample N)
results/_sample/
figures/_sample/

# Website: dependencies, build, and the data copied from data/site/ at every build
web/node_modules/
web/dist/
web/.vite/
web/public/data/

# OS / editor / local assistant settings
.DS_Store
Thumbs.db
.vscode/
.claude/
